# Copy this file to ".env" and fill in the values.
# NEVER commit the real ".env" file (it's already excluded via .gitignore).

# --- Authentication -------------------------------------------------------
# Personal Access Token with the minimum required permissions (see the
# "PAT permissions" docs page: https://tommasomarchionni.github.io/github-runner/pat-permissions/).
# Rotate it periodically.
GITHUB_PAT=

# --- Scope: fill in ONLY ONE of the two -----------------------------------
# Runner tied to a single repository:
GITHUB_REPOSITORY=tommasomarchionni/REPOSITORY_NAME
# Runner shared at the organization level (leave GITHUB_REPOSITORY empty):
# GITHUB_ORG=organization-name

# --- GitHub Enterprise Server (leave the defaults for github.com) --------
GITHUB_SERVER_URL=https://github.com
GITHUB_API_URL=https://api.github.com

# --- Runner identity and behavior -----------------------------------------
RUNNER_NAME=github-runner-01
# Custom labels, comma-separated (in addition to the automatic self-hosted/linux/x64)
RUNNER_LABELS=ci,docker,dokploy
# Runner group (only relevant for organization/enterprise runners)
RUNNER_GROUP=Default
RUNNER_WORKDIR=_work
# true = "run once" ephemeral runner: executes a single job then deregisters itself
RUNNER_EPHEMERAL=false
# true = prevents the runner from attempting a self-update (recommended: update the image instead)
RUNNER_DISABLE_UPDATE=true
RUNNER_REPLACE=true
RUNNER_UNREGISTER_TIMEOUT=30
LOG_LEVEL=info
# Self-healing: if after a container restart/recreate the registration
# stored in the volume turns out to be invalid (e.g. removed by hand on
# GitHub, or the volume was copied from another host), the container
# re-registers itself with a fresh token minted from GITHUB_PAT instead of
# crash-looping. You'll rarely need to change these.
RUNNER_STARTUP_GRACE_SECONDS=20
RUNNER_START_MAX_ATTEMPTS=3
# true = ignore the existing registration and force a new one on the next
# start (use only for troubleshooting, then set it back to false)
RUNNER_FORCE_RECONFIGURE=false
# Extra arguments passed directly to config.sh (advanced, optional)
EXTRA_CONFIG_ARGS=

# --- Image build (only used by docker-compose.yml, not docker-compose.prebuilt.yml) ---
RUNNER_VERSION=2.337.0
# Leave empty to auto-detect from the build platform (recommended).
RUNNER_ARCH=
# true to bundle the Docker CLI in the image (see docs/docker-in-workflow.md)
INSTALL_DOCKER_CLI=true
RUNNER_IMAGE_NAME=github-runner
RUNNER_IMAGE_TAG=local

# --- Prebuilt image (only used by docker-compose.prebuilt.yml) -----------
# See docs/prebuilt-image.md. Any tag published to ghcr.io/tommasomarchionni/github-runner.
# RUNNER_IMAGE_TAG=latest

# --- Resources --------------------------------------------------------
RUNNER_MEM_LIMIT=2g
RUNNER_CPUS=2.0
RUNNER_VOLUME_NAME=github-runner-data
